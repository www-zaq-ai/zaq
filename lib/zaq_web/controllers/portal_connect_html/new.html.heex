<AuthLayout.auth_layout
  heading="Connect your Portal account"
  subtitle="Set the password for your ZAQ administrator account."
>
  <:header_icon>
    <img src={~p"/images/zaq.png"} alt="ZAQ" class="zaq-auth-logo-img" />
  </:header_icon>

  <p :if={@error} role="alert" class="zaq-feedback-banner zaq-danger zaq-text-body">{@error}</p>

  <p class="zaq-text-body">
    Your login username: <strong>{@username}</strong>
    <br /> Use this username and the password you set below to sign in later.
  </p>

  {live_render(@conn, PortalConnectPasswordLive)}
</AuthLayout.auth_layout>
