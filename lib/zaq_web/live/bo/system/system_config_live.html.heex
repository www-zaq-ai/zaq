<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@page_title}
  current_path={@current_path}
>
  <div id="oauth-popup-listener" phx-hook="OAuthPopupListener"></div>

  <div class="flex flex-col lg:flex-row zaq-layout-section-gap items-start">
    <%!-- Sidebar --%>
    <div class="w-full lg:w-52 shrink-0">
      <div class="zaq-card-default zaq-border-default overflow-hidden">
        <div class="px-4 py-3" style="background: var(--zaq-surface-color-base)">
          <p class="zaq-text-caption" style="color: var(--zaq-text-color-body-secondary)">
            Configuration
          </p>
        </div>
        <nav class="p-2 space-y-0.5">
          <ZaqWeb.Components.DesignSystem.Button.button
            :for={
              {tab, label} <- [
                people_access: "People access",
                ai_credentials: "AI Credentials",
                auth_credentials: "Auth Credentials",
                mcps: "MCPs",
                outbound_http: "Outbound HTTP",
                global: "Global",
                web_browsing: "Web browsing",
                skills: "Skills",
                llm: "LLM",
                rag: "RAG",
                telemetry: "Telemetry"
              ]
            }
            id={"#{tab |> Atom.to_string() |> String.replace("_", "-")}-tab"}
            variant={:tertiary}
            phx-click="switch_tab"
            phx-value-tab={tab}
            aria-current={if @active_tab == tab, do: "page", else: "false"}
            active={@active_tab == tab}
            class="w-full justify-start"
          >{label}</ZaqWeb.Components.DesignSystem.Button.button>
        </nav>
      </div>
    </div>

    <%!-- Content --%>
    <div class="w-full flex-1 min-w-0">
      <ZaqWeb.Live.BO.System.SystemConfig.PeopleAccessTab.panel
        :if={@active_tab == :people_access}
        form={@people_access_form}
        load_error={@people_access_load_error}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.AICredentialsTab.panel
        :if={@active_tab == :ai_credentials}
        credentials={@ai_credentials}
        ai_grants={@ai_grants}
        form={@ai_credential_form}
        modal={@ai_credential_modal}
        delete_confirm_modal={@ai_credential_delete_confirm_modal}
        action={@ai_credential_action}
        credential_id={@ai_credential_id}
        provider_options={@ai_provider_options}
        oauth_behaviours={@oauth_behaviours}
        device_attempt={@ai_device_attempt}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.ConnectCredentialsTab.panel
        :if={@active_tab == :auth_credentials}
        credentials={@connect_credentials}
        grants_modal={@connect_grants_modal}
        selected_credential={@selected_connect_credential}
        selected_grants={@selected_connect_grants}
        selected_connect_refresh_schedule={@selected_connect_refresh_schedule}
        credential_modal={@connect_credential_modal}
        credential_form={@connect_credential_form}
        credential_changeset={@connect_credential_changeset}
        credential_errors={@connect_credential_errors}
        connect_default_scopes_text={@connect_default_scopes_text}
        oauth_behaviours={@oauth_behaviours}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.MCPTab.panel
        :if={@active_tab == :mcps}
        entries={@mcp_endpoints}
        total_count={@mcp_total_count}
        page={@mcp_page}
        per_page={@mcp_per_page}
        filter_name={@mcp_filter_name}
        filter_type={@mcp_filter_type}
        filter_status={@mcp_filter_status}
        form={@mcp_endpoint_form}
        rows={@mcp_endpoint_rows}
        modal={@mcp_endpoint_modal}
        action={@mcp_endpoint_action}
        delete_confirm_modal={@mcp_endpoint_delete_confirm_modal}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.OutboundHttpTab.panel
        :if={@active_tab == :outbound_http}
        policy_form={@outbound_http_policy_form}
        providers={@http_credential_providers}
        provider_modal={@http_credential_provider_modal}
        provider_form={@http_credential_provider_form}
        provider_action={@http_credential_provider_action}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.GlobalTab.panel
        :if={@active_tab == :global}
        global_agent_options={@global_agent_options}
        global_default_agent_id={@global_default_agent_id}
        global_base_url={@global_base_url}
        global_language={@global_language}
        global_timezone={@global_timezone}
        detected_timezone={@detected_timezone}
      />
      <ZaqWeb.Components.DesignSystem.CardShell.card_shell
        :if={@active_tab == :global}
        id="small-model-section"
        class="mt-5"
      >
        <div class="space-y-4">
          <header>
            <h2 class="zaq-text-h3" style="color: var(--zaq-text-color-body-default)">
              Small model
            </h2>
            <p class="zaq-text-caption" style="color: var(--zaq-text-color-body-secondary)">
              Used for conversation titles. Without a selection, titles are derived from the first message.
            </p>
          </header>
          <ZaqWeb.Live.BO.System.SystemConfig.OperationModelFields.selection_form
            kind={:small}
            title="Small Model"
            form={@operation_model_forms[:small]}
            options={@operation_model_options[:small]}
            credential_options={@llm_credential_options}
          />
        </div>
      </ZaqWeb.Components.DesignSystem.CardShell.card_shell>
      <SkillsTab.panel
        :if={@active_tab == :skills}
        config={@skill_resource_config}
        sources={@skill_resource_sources}
        source_id={@skill_resource_source_id}
        folder_modal={@skill_resource_folder_modal}
        new_folder_modal={@skill_resource_new_folder_modal}
        folder_entries={@skill_resource_folder_entries}
        folder_stack={@skill_resource_folder_stack}
        folder_error={@skill_resource_folder_error}
        modal_error={@modal_error}
        modal_name={@modal_name}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.WebBrowsingTab.panel
        :if={@active_tab == :web_browsing}
        config={@web_browsing_config}
        load_error={@web_browsing_load_error}
        sources={@web_browsing_sources}
        source_id={@web_browsing_source_id}
        folder_modal={@web_browsing_folder_modal}
        new_folder_modal={@web_browsing_new_folder_modal}
        folder_entries={@web_browsing_folder_entries}
        folder_stack={@web_browsing_folder_stack}
        folder_error={@web_browsing_folder_error}
        modal_error={@modal_error}
        modal_name={@modal_name}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.LLMTab.panel
        :if={@active_tab == :llm}
        form={@llm_form}
        credential_options={@llm_credential_options}
        model_options={@llm_model_options}
        capabilities={@llm_capabilities}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.RAGTab.panel
        :if={@active_tab == :rag}
        embedding_form={@embedding_form}
        image_to_text_form={@image_to_text_form}
        retrieval_form={@retrieval_form}
        translation_form={@operation_model_forms[:translation]}
        translation_model_options={@operation_model_options[:translation]}
        model_forms={@rag_model_forms}
        model_options={@rag_model_options}
        credential_options={@embedding_credential_options}
        embedding_model_options={@embedding_model_options}
        image_to_text_model_options={@image_to_text_model_options}
        locked={@embedding_locked}
        unlock_modal={@embedding_unlock_modal}
        model_changed={@model_changed}
        save_confirm_modal={@embedding_save_confirm_modal}
      />
      <ZaqWeb.Live.BO.System.SystemConfig.TelemetryTab.panel
        :if={@active_tab == :telemetry}
        form={@telemetry_form}
        studio_running={@studio_running}
        studio_can_start={@studio_can_start}
      />
    </div>
  </div>

  <ZaqWeb.Components.BOModal.modal_shell
    :if={@oauth_claim_modal}
    id="oauth-claim-modal"
    cancel_event="close_oauth_claim"
    max_width_class="max-w-md"
  >
    <div class="text-center">
      <div class="mx-auto mb-4 grid h-10 w-10 place-items-center rounded-lg bg-[#03b6d4]/10 text-[#03b6d4]">
        <.icon name="hero-arrow-top-right-on-square" class="h-5 w-5" />
      </div>
      <h3 class="mb-2 font-mono text-base font-bold text-black">
        OAuth authorization in progress
      </h3>
      <p class="mb-6 font-mono text-[0.75rem] text-black/40">
        Complete the provider authorization in the popup window. This dialog updates automatically when finished.
      </p>
      <button
        type="button"
        phx-click="close_oauth_claim"
        class="rounded-xl border border-black/10 px-5 py-2.5 font-mono text-[0.75rem] text-black/40 transition-all hover:border-black/20 hover:text-black"
      >
        Cancel
      </button>
    </div>
  </ZaqWeb.Components.BOModal.modal_shell>
</ZaqWeb.Components.BOLayout.bo_layout>
