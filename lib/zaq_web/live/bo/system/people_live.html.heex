<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  page_title="People"
  current_path={@current_path}
  flash={@flash}
  features_version={@features_version}
>
  <.delete_confirm_bar
    :if={@confirm_delete && !Map.has_key?(@confirm_delete, :person_ids)}
    confirm_delete={@confirm_delete}
  />
  <ZaqWeb.Components.BOModal.form_dialog
    :if={@confirm_delete && Map.has_key?(@confirm_delete, :person_ids)}
    id="people-bulk-delete-dialog"
    phx-hook="PeopleBulkDeleteDialog"
    data-return-focus-id="bulk-delete-button"
    title="Delete selected people"
    cancel_event="cancel_bulk_delete"
    max_width_class="zaq-modal--width-sm"
  >
    <p class="zaq-text-body">{@confirm_delete.message}</p>
    <:actions>
      <DSButton.button
        id="cancel-people-bulk-delete"
        variant={:secondary}
        phx-click="cancel_bulk_delete"
      >
        Cancel
      </DSButton.button>
      <DSButton.button
        id="confirm-people-bulk-delete"
        variant={:tertiary}
        danger
        phx-click="confirm_bulk_delete"
      >
        Delete
      </DSButton.button>
    </:actions>
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.MasterDetailLayout.master_detail
    show_detail={@active_tab == :people and not is_nil(@selected_person)}
    master_id="people-master-pane"
    master_when_no_detail_class="w-full min-w-0"
    detail_id="people-detail-pane"
  >
    <:master>
      <div class="zaq-master-pane-toolbar flex-wrap">
        <DSToggle.toggle
          value={Atom.to_string(@active_tab)}
          event="switch_tab"
          value_param="tab"
          choices={[
            %{value: "people", label: "People"},
            %{value: "teams", label: "Teams"},
            %{value: "permissions", label: "Permissions"}
          ]}
        />
        <DSButton.button
          :if={@active_tab == :people}
          id="new-person-button"
          variant={:primary}
          icon="hero-plus"
          class="shrink-0"
          phx-click="open_modal"
          phx-value-action="new"
          phx-value-entity="person"
        >
          Add person
        </DSButton.button>
        <DSButton.button
          :if={@active_tab == :teams}
          id="new-team-button"
          variant={:primary}
          icon="hero-plus"
          class="shrink-0"
          phx-click="open_modal"
          phx-value-action="new"
          phx-value-entity="team"
        >
          New Team
        </DSButton.button>
      </div>
      <.people_tab
        :if={@active_tab == :people}
        people={@people}
        selected_people={@selected_people}
        selected_person={@selected_person}
        teams={@teams}
        filter_name={@filter_name}
        filter_email={@filter_email}
        filter_phone={@filter_phone}
        filter_complete={@filter_complete}
        filter_team_id={@filter_team_id}
        page={@page}
        per_page={@per_page}
        total_count={@total_count}
      />
      <.teams_tab :if={@active_tab == :teams} teams={@teams} />
      <div :if={@active_tab == :permissions} id="people-permissions" class="min-w-0 max-w-full">
        <%= if @permissions_matrix do %>
          <div
            id="people-permissions-state"
            phx-hook="PeoplePermissions"
            data-generation={@permissions_generation}
          >
            <DSTable.table
              id="people-permissions-table"
              min_width="640px"
              wrapper_class="relative overflow-x-auto max-w-full"
            >
              <:head>
                <DSTable.table_head_row>
                  <DSTable.table_cell element={:th} nowrap>Permission</DSTable.table_cell>
                  <DSTable.table_cell :for={column <- @permissions_matrix.scopes} element={:th}>
                    <span class="block min-w-32 max-w-64 break-words">{column.label}</span>
                  </DSTable.table_cell>
                </DSTable.table_head_row>
              </:head>
              <:body>
                <DSTable.table_row :for={row <- @permissions_matrix.rows}>
                  <DSTable.table_cell element={:th} nowrap>{row.label}</DSTable.table_cell>
                  <DSTable.table_cell :for={column <- @permissions_matrix.scopes}>
                    <DSSwitch.switch
                      id={"permission-#{permission_scope_key(column.scope)}-#{row.permission}"}
                      label={"#{row.label} — #{column.label} (#{permission_scope_key(column.scope)})"}
                      class="zaq-permission-switch relative [&_.zaq-switch-text]:sr-only"
                      checked={MapSet.member?(row.grants, column.scope)}
                      form_hidden={false}
                      phx-click={
                        JS.push("set_permission",
                          value: %{
                            scope: permission_scope_key(column.scope),
                            permission: Atom.to_string(row.permission),
                            enabled: not MapSet.member?(row.grants, column.scope)
                          }
                        )
                      }
                    />
                  </DSTable.table_cell>
                </DSTable.table_row>
              </:body>
            </DSTable.table>
          </div>
        <% else %>
          <p class="zaq-text-body">Permissions need to be reloaded before making changes.</p>
          <DSButton.button
            id="reload-people-permissions"
            variant={:secondary}
            phx-click="reload_permissions"
          >
            Reload permissions
          </DSButton.button>
        <% end %>
      </div>
    </:master>

    <:detail>
      <.person_detail
        selected_person={@selected_person}
        person_channels={@person_channels}
        person_documents={@person_documents}
        teams={@teams}
        agent_options={@agent_options}
      />
    </:detail>
  </ZaqWeb.Components.MasterDetailLayout.master_detail>

  <.people_modal
    :if={@modal}
    modal={@modal}
    modal_entity={@modal_entity}
    modal_changeset={@modal_changeset}
    merge_survivor={@merge_survivor}
    merge_loser={@merge_loser}
    merge_search={@merge_search}
    merge_candidates={@merge_candidates}
    selected_person={@selected_person}
    agent_options={@agent_options}
  />
</ZaqWeb.Components.BOLayout.bo_layout>
