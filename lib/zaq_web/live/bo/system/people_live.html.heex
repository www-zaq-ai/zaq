<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  page_title="People"
  current_path={@current_path}
  flash={@flash}
  features_version={@features_version}
>
  <.delete_confirm_bar
    :if={@confirm_delete && !Map.has_key?(@confirm_delete, :person_ids)}
    confirm_delete={@confirm_delete}
  />
  <ZaqWeb.Components.BOModal.form_dialog
    :if={@confirm_delete && Map.has_key?(@confirm_delete, :person_ids)}
    id="people-bulk-delete-dialog"
    phx-hook="PeopleBulkDeleteDialog"
    data-return-focus-id="bulk-delete-button"
    title="Delete selected people"
    cancel_event="cancel_bulk_delete"
    max_width_class="zaq-modal--width-sm"
  >
    <p class="zaq-text-body">{@confirm_delete.message}</p>
    <:actions>
      <DSButton.button
        id="cancel-people-bulk-delete"
        variant={:secondary}
        phx-click="cancel_bulk_delete"
      >
        Cancel
      </DSButton.button>
      <DSButton.button
        id="confirm-people-bulk-delete"
        variant={:tertiary}
        danger
        phx-click="confirm_bulk_delete"
      >
        Delete
      </DSButton.button>
    </:actions>
  </ZaqWeb.Components.BOModal.form_dialog>

  <ZaqWeb.Components.MasterDetailLayout.master_detail
    show_detail={not is_nil(@selected_person)}
    master_id="people-master-pane"
    detail_id="people-detail-pane"
  >
    <:master>
      <div class="zaq-master-pane-toolbar">
        <DSToggle.toggle
          value={Atom.to_string(@active_tab)}
          event="switch_tab"
          value_param="tab"
          choices={[
            %{value: "people", label: "People"},
            %{value: "teams", label: "Teams"}
          ]}
        />
        <DSButton.button
          :if={@active_tab == :people}
          id="new-person-button"
          variant={:primary}
          icon="hero-plus"
          class="shrink-0"
          phx-click="open_modal"
          phx-value-action="new"
          phx-value-entity="person"
        >
          Add person
        </DSButton.button>
        <DSButton.button
          :if={@active_tab == :teams}
          id="new-team-button"
          variant={:primary}
          icon="hero-plus"
          class="shrink-0"
          phx-click="open_modal"
          phx-value-action="new"
          phx-value-entity="team"
        >
          New Team
        </DSButton.button>
      </div>
      <.people_tab
        :if={@active_tab == :people}
        people={@people}
        selected_people={@selected_people}
        selected_person={@selected_person}
        teams={@teams}
        filter_name={@filter_name}
        filter_email={@filter_email}
        filter_phone={@filter_phone}
        filter_complete={@filter_complete}
        filter_team_id={@filter_team_id}
        page={@page}
        per_page={@per_page}
        total_count={@total_count}
      />
      <.teams_tab :if={@active_tab == :teams} teams={@teams} />
    </:master>

    <:detail>
      <.person_detail
        selected_person={@selected_person}
        person_channels={@person_channels}
        person_documents={@person_documents}
        teams={@teams}
        agent_options={@agent_options}
      />
    </:detail>
  </ZaqWeb.Components.MasterDetailLayout.master_detail>

  <.people_modal
    :if={@modal}
    modal={@modal}
    modal_entity={@modal_entity}
    modal_changeset={@modal_changeset}
    merge_survivor={@merge_survivor}
    merge_loser={@merge_loser}
    merge_search={@merge_search}
    merge_candidates={@merge_candidates}
    selected_person={@selected_person}
    agent_options={@agent_options}
  />
</ZaqWeb.Components.BOLayout.bo_layout>
