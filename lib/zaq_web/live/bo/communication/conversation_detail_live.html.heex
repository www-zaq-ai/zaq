<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@conversation.title || "Conversation"}
  current_path={@current_path}
  features_version={@features_version}
>
  <ZaqWeb.Components.DesignSystem.ConversationDetail.conversation_detail
    conversation={@conversation}
    messages={@messages}
    shares={@shares}
    show_share_dialog={@show_share_dialog}
    show_feedback_modal={@show_feedback_modal}
    feedback_reasons={@feedback_reasons}
    feedback_comment={@feedback_comment}
    message_info_modal_for={@message_info_modal_for}
    message_info_modal={@message_info_modal}
    expanded_trace_ids={@expanded_trace_ids}
    preview={@preview}
  />
</ZaqWeb.Components.BOLayout.bo_layout>
