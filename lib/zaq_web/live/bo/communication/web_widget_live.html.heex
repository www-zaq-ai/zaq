<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title={@page_title}
  page_subtitle="Embed a private, authenticated conversation on your website."
  page_icon_provider="web_widget"
  current_path={@current_path}
  features_version={@features_version}
>
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <ZaqWeb.Components.DesignSystem.Breadcrumb.page_breadcrumb
        id="widget-breadcrumb"
        items={[
          %{label: "Channels", to: ~p"/bo/channels"},
          %{label: "Communication", to: ~p"/bo/channels/retrieval"},
          %{label: @page_title, current: true}
        ]}
      />
      <div class="flex flex-wrap gap-2">
        <ZaqWeb.Components.DesignSystem.Button.button
          id="new-widget-config"
          phx-click="new_connector"
          icon="hero-plus"
        >Add configuration</ZaqWeb.Components.DesignSystem.Button.button>
      </div>
    </div>
    <div class="space-y-3">
      <div :for={config <- @configs} class="space-y-3">
        <ZaqWeb.Components.DesignSystem.ChannelConnectorCard.channel_connector_card
          id={"widget-connector-#{config.id}"}
          name={config.name}
          provider={@page_title}
          url={"Widget ID: #{config.id}"}
          enabled={config.enabled}
          enabled_label="Enabled"
          connector_id={config.id}
          icon="hero-globe-alt"
          select_event="select_connector"
          selected={not is_nil(@selected) and @selected.id == config.id}
          toggle_event="toggle_enabled"
          toggle_button_id={"toggle-widget-#{config.id}"}
          toggle_disabled={!config.enabled && (!@base_url || !adapter_available?(@adapter))}
          toggle_disabled_reason={
            if !config.enabled && (!@base_url || !adapter_available?(@adapter)),
              do: "Configure the global base URL and widget adapter before enabling."
          }
          edit_event="select_connector"
          edit_button_id={"edit-widget-#{config.id}"}
        >
          <:status :if={config.enabled}>
            <ZaqWeb.Components.DesignSystem.Table.table_badge
              id={"widget-health-#{config.id}"}
              status={IngressStatusUI.label(widget_health(config, @ingress_statuses))}
              tone={IngressStatusUI.tone(widget_health(config, @ingress_statuses))}
              title={widget_health(config, @ingress_statuses).summary}
            >
              {IngressStatusUI.label(widget_health(config, @ingress_statuses))}
            </ZaqWeb.Components.DesignSystem.Table.table_badge>
          </:status>
          <:actions>
            <ZaqWeb.Components.DesignSystem.Button.button
              id={"widget-script-#{config.id}"}
              variant={:secondary}
              phx-click="open_installation"
              phx-value-id={config.id}
              disabled={!@base_url || !adapter_available?(@adapter)}
              aria-haspopup="dialog"
              aria-controls="widget-installation-modal"
            >Installation script</ZaqWeb.Components.DesignSystem.Button.button>
            <ZaqWeb.Components.DesignSystem.Button.button
              id={"archive-widget-#{config.id}"}
              variant={:tertiary}
              danger
              icon="hero-trash"
              icon_only
              aria-label="Archive configuration"
              title="Archive configuration"
              phx-click="archive"
              phx-value-id={config.id}
              data-confirm="Archive this widget configuration? Its runtime will stop; conversation history is preserved."
            />
          </:actions>
        </ZaqWeb.Components.DesignSystem.ChannelConnectorCard.channel_connector_card>
      </div>
    </div>
    <p :if={@configs == []} class="zaq-field-helper">
      No widget configurations yet. Add a configuration to get started.
    </p>
    <.configuration_recovery :if={@recovery_message && !@modal_open} message={@recovery_message} />
    <ZaqWeb.Components.BOModal.form_dialog
      :if={@installation_config}
      id="widget-installation-modal"
      cancel_event="close_installation"
      title={"Install #{@installation_config.name} on your website"}
      max_width_class="zaq-modal--width-lg"
      body_class="space-y-6"
    >
      <section class="space-y-4">
        <%= case @snippet do %>
          <% {:ok, snippet} -> %>
            <ZaqWeb.Components.DesignSystem.Input.input
              id="widget-install-script"
              name="widget-install-script"
              type="textarea"
              label="Installation script"
              value={snippet}
              rows="4"
              readonly
            />
            <ZaqWeb.Components.DesignSystem.Button.button
              id="copy-widget-script"
              variant={:secondary}
              icon="hero-clipboard"
              phx-hook="CopyToClipboard"
              data-share-url={snippet}
            >Copy installation script</ZaqWeb.Components.DesignSystem.Button.button>
          <% _ -> %>
            <ZaqWeb.Components.DesignSystem.FeedbackBanner.feedback_banner
              id="widget-script-unavailable"
              kind={:error}
              message={snippet_message(@snippet)}
              auto_dismiss={false}
              dismissible={false}
            />
        <% end %>
      </section>

      <section id="widget-installation-required" class="zaq-card-default p-4 space-y-3">
        <h3 class="zaq-text-h3">Required setup</h3>
        <dl class="space-y-3">
          <div>
            <dt class="zaq-text-code">src</dt>
            <dd class="zaq-text-body-sm">
              Loads the widget embed script from ZAQ. Keep the generated URL unchanged.
            </dd>
          </div>
          <div>
            <dt class="zaq-text-code">data-widget-id</dt>
            <dd class="zaq-text-body-sm">
              Identifies this connector. Keep the generated value {@installation_config.id} unchanged.
            </dd>
          </div>
          <div>
            <dt class="zaq-text-code">data-token-url</dt>
            <dd class="zaq-text-body-sm">
              Points to an authenticated, same-origin GET endpoint on your website. Add it when the generated script does not already include a host-configured token path.
            </dd>
          </div>
          <div>
            <dt class="zaq-text-code">defer</dt>
            <dd class="zaq-text-body-sm">
              Defers the loader until the page is parsed. Keep it on the generated script.
            </dd>
          </div>
        </dl>
      </section>

      <section id="widget-installation-optional" class="zaq-card-default p-4 space-y-3">
        <h3 class="zaq-text-h3">Optional attributes</h3>
        <dl class="space-y-3">
          <div>
            <dt class="zaq-text-code">iframe-location-id="#support-chat"</dt>
            <dd class="zaq-text-body-sm">
              Mounts the widget inside an existing div selected by this CSS selector. Give that container an explicit height. Omit it for the default floating widget.
            </dd>
          </div>
          <div>
            <dt class="zaq-text-code">stylesheet-url="/widget-brand.css"</dt>
            <dd class="zaq-text-body-sm">
              Loads custom CSS inside the iframe. Relative URLs resolve against the parent page; absolute URLs must use HTTP(S), with HTTPS for HTTPS pages.
            </dd>
          </div>
          <div>
            <dt class="zaq-text-code">data-widget-url</dt>
            <dd class="zaq-text-body-sm">
              Overrides the iframe route on the same ZAQ origin as the loader. Normally the generated script supplies this when needed; keep its generated value unchanged.
            </dd>
          </div>
        </dl>
      </section>

      <section id="widget-token-response" class="space-y-2">
        <h3 class="zaq-text-h3">Identity-token endpoint</h3>
        <p class="zaq-text-body-sm">
          Return <span class="zaq-text-code">{"{\"identity_token\":\"<signed JWT>\"}"}</span>
          with <span class="zaq-text-code">Cache-Control: no-store</span>. Derive the visitor identity from your authenticated backend session; never expose the connector authentication key to the browser.
        </p>
      </section>

      <:actions>
        <ZaqWeb.Components.DesignSystem.Button.button
          id="close-widget-installation"
          variant={:secondary}
          phx-click="close_installation"
        >Done</ZaqWeb.Components.DesignSystem.Button.button>
      </:actions>
    </ZaqWeb.Components.BOModal.form_dialog>
    <ZaqWeb.Components.BOModal.form_dialog
      :if={@modal_open}
      id="widget-config-modal"
      cancel_event="close_modal"
      title={if @selected, do: "Edit #{@page_title}", else: "Add #{@page_title}"}
      max_width_class="zaq-modal--width-lg"
      body_class="space-y-6"
    >
      <div
        :if={!@base_url || !adapter_available?(@adapter)}
        id="widget-prerequisite-errors"
        class="space-y-3"
      >
        <div :if={!@base_url} class="space-y-2">
          <ZaqWeb.Components.DesignSystem.FeedbackBanner.feedback_banner
            id="widget-base-url-error"
            kind={:error}
            auto_dismiss={false}
            dismissible={false}
            message="Global base URL is missing. Set it in System Configuration before enabling this widget or generating its installation script. You can still save this configuration disabled."
          />
          <ZaqWeb.Components.DesignSystem.Link.nav_link
            destination={~p"/bo/system-config"}
            size={:sm}
            tone={:accent}
          >
            Open System Configuration
          </ZaqWeb.Components.DesignSystem.Link.nav_link>
        </div>
        <ZaqWeb.Components.DesignSystem.FeedbackBanner.feedback_banner
          :if={!adapter_available?(@adapter)}
          id="widget-adapter-error"
          kind={:error}
          auto_dismiss={false}
          dismissible={false}
          message={"#{@page_title} adapter is not configured or cannot be reached. Ask your ZAQ administrator to install and configure the external adapter in the Channels service before enabling this widget or generating its installation script. You can still save this configuration disabled."}
        />
      </div>
      <.configuration_recovery :if={@recovery_message} message={@recovery_message} />
      <section class="space-y-5">
        <.form
          for={@form}
          id="widget-config-form"
          phx-submit="save"
          phx-change="validate"
          class="space-y-5"
        >
          <ZaqWeb.Components.DesignSystem.FeedbackBanner.feedback_banner
            :if={unscoped_error_messages(@errors) != []}
            id="widget-settings-error"
            kind={:error}
            message={Enum.join(unscoped_error_messages(@errors), " ")}
            auto_dismiss={false}
            dismissible={false}
          />
          <ZaqWeb.Components.DesignSystem.Input.input
            id="widget_name"
            name="widget[name]"
            value={@form[:name].value}
            errors={field_errors(@errors, "name")}
            label="Configuration name"
            required
          />
          <div id="widget-allowed-domains-field">
            <ZaqWeb.Components.DesignSystem.Input.input
              id="widget_allowed_domains"
              name="widget[allowed_domains]"
              value={@form[:allowed_domains].value}
              errors={field_errors(@errors, "allowed_domains")}
              type="textarea"
              label="Allowed embedding origins"
              rows="4"
              placeholder="https://www.example.com"
              hint="One exact HTTP(S) origin per line, without a trailing slash. Empty permits no embedding."
            />
          </div>
          <AgentRoutingOptions.rule_select
            id="widget-agent"
            form="widget"
            scope={routing_scope(@selected)}
            label="Default agent"
            default_label="Use inherited routing"
            value={routing_value(@form, @selected)}
            options={@agent_options}
            errors={field_errors(@errors, "agent_id")}
            hint="Uses connector-scoped routing. Inherited routing and NONE retain their existing behavior."
            hint_id="widget-agent-hint"
          />
          <ZaqWeb.Components.DesignSystem.Input.input
            id="widget-identity-issuer"
            name="widget[identity_issuer]"
            value={@form[:identity_issuer].value}
            errors={field_errors(@errors, "identity_issuer")}
            label="JWT token issuer"
            placeholder="Preserve existing adapter value"
            hint={policy_hint(@selected, @ingress_statuses, :identity_issuer)}
          />
          <ZaqWeb.Components.DesignSystem.Input.input
            id="widget-identity-audience"
            name="widget[identity_audience]"
            value={@form[:identity_audience].value}
            errors={field_errors(@errors, "identity_audience")}
            label="JWT token audience"
            placeholder="Preserve existing adapter value"
            hint={policy_hint(@selected, @ingress_statuses, :identity_audience)}
          />
          <ZaqWeb.Select.select
            id="widget-same-site"
            name="widget[same_site]"
            label="Cookie SameSite policy"
            value={@form[:same_site].value}
            errors={field_errors(@errors, "same_site")}
            hint={
              "None requires Secure cookies over HTTPS. Browser third-party-cookie restrictions still apply. " <>
                policy_hint(@selected, @ingress_statuses, :same_site)
            }
            hint_id="widget-same-site-hint"
            options={
              if @selected && is_nil(@selected.same_site),
                do: [
                  {"Preserve existing policy", ""},
                  {"None", "None"},
                  {"Lax", "Lax"},
                  {"Strict", "Strict"}
                ],
                else: [{"None", "None"}, {"Lax", "Lax"}, {"Strict", "Strict"}]
            }
          />
          <ZaqWeb.Components.LiveUpdateSettings.fields
            :if={@selected}
            id={"stream-updates-#{@selected.id}"}
            policy={@live_update_policy}
            errors={@live_update_errors}
            load_error={
              if is_nil(@live_update_policy), do: "Unable to load streamed-update settings"
            }
          />
        </.form>
      </section>
      <section class="space-y-4">
        <h2 class="zaq-text-h3">Sender authentication</h2>
        <p :if={!@selected} class="zaq-field-helper">
          Save this configuration first to generate its authentication key.
        </p>
        <div id="widget-key-control-row" class="flex items-end gap-2">
          <div class="min-w-0 flex-1">
            <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
              id="widget-key-status"
              name="authentication_key_status"
              label="Authentication key"
              value=""
              readonly
              autocomplete="off"
              placeholder={
                if @selected && @selected.key_present?,
                  do: "Configured — stored encrypted",
                  else: "Not generated"
              }
            />
          </div>
          <ZaqWeb.Components.DesignSystem.Button.button
            :if={!@selected || !@selected.key_present?}
            id="generate-widget-key"
            phx-click="generate_key"
            variant={:secondary}
            icon="hero-key"
            icon_only
            aria-label="Generate authentication key"
            title="Generate authentication key"
            disabled={!@selected}
          />
          <ZaqWeb.Components.DesignSystem.Button.button
            :if={@selected && @selected.key_present?}
            id="rotate-widget-key"
            phx-click="rotate_key"
            variant={:secondary}
            icon="hero-arrow-path"
            icon_only
            aria-label="Rotate authentication key"
            title="Rotate authentication key"
            data-confirm="Replace this key? Reprovision your host backend immediately. The adapter must reject old-key assertions and revoke affected sessions; runtime synchronization failures require retry."
          />
        </div>
        <ZaqWeb.Components.DesignSystem.FieldHint.field_messages
          hint="Stored keys are never revealed again. Generate or rotate to receive a new key once."
          hint_id="widget-key-hint"
        />
        <p class="zaq-text-body-sm">
          {if @selected && @selected.key_present?,
            do: "Authentication key configured",
            else: "No authentication key generated"}
        </p>
        <p
          :if={@selected && @selected.key_rotated_at}
          id="widget-key-generated-at"
          class="zaq-field-helper"
        >
          Last generated or rotated:
          <time datetime={@selected.key_rotated_at}>
            {format_key_rotation(@selected.key_rotated_at)}
          </time>
        </p>
        <ZaqWeb.Components.DesignSystem.FeedbackBanner.feedback_banner
          id="widget-key-warning"
          kind={:warning}
          auto_dismiss={false}
          dismissible={false}
          message={
            if @authentication_key,
              do:
                "This key is shown only once. Copy it now and store it securely in your host application's backend. Never put it in the website script or browser widget.",
              else:
                "Store the authentication key securely in your host application's backend. Never put it in the website script or browser widget."
          }
        />
        <div :if={@authentication_key} id="widget-key-reveal" class="space-y-3">
          <ZaqWeb.Components.DesignSystem.SecretInput.secret_input
            id="new-widget-key"
            name="authentication_key"
            label="New authentication key"
            value={@authentication_key}
            readonly
            autocomplete="off"
          />
          <div class="flex flex-wrap gap-2">
            <ZaqWeb.Components.DesignSystem.Button.button
              id="copy-widget-key"
              variant={:secondary}
              phx-hook="CopyToClipboard"
              data-share-url={@authentication_key}
            >Copy key</ZaqWeb.Components.DesignSystem.Button.button>
            <ZaqWeb.Components.DesignSystem.Button.button
              id="dismiss-widget-key"
              variant={:tertiary}
              phx-click="dismiss_key"
            >Dismiss key</ZaqWeb.Components.DesignSystem.Button.button>
          </div>
        </div>
      </section>
      <ZaqWeb.Components.DesignSystem.Checkbox.checkbox
        field={@form[:enabled]}
        errors={field_errors(@errors, "enabled")}
        id="widget-enabled"
        label="Enabled"
        form="widget-config-form"
        disabled={
          (!@base_url || !adapter_available?(@adapter)) && !(@selected && @selected.enabled)
        }
      />
      <:actions>
        <ZaqWeb.Components.DesignSystem.Button.button
          type="submit"
          id="save-widget-config"
          form="widget-config-form"
        >Save configuration</ZaqWeb.Components.DesignSystem.Button.button>
        <ZaqWeb.Components.DesignSystem.Button.button
          id="close-widget-modal"
          variant={:secondary}
          phx-click="close_modal"
        >Cancel</ZaqWeb.Components.DesignSystem.Button.button>
      </:actions>
    </ZaqWeb.Components.BOModal.form_dialog>
  </div>
</ZaqWeb.Components.BOLayout.bo_layout>
