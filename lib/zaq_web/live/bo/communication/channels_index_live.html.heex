<%= if !@service_available do %>
  <ZaqWeb.Components.ServiceUnavailable.page
    current_user={@current_user}
    current_path={@current_path}
    page_title={@page_title}
    services={@required_roles}
  />
<% else %>
  <ZaqWeb.Components.BOLayout.bo_layout
    current_user={@current_user}
    flash={@flash}
    page_title={@page_title}
    page_subtitle={@page_subtitle}
    current_path={@current_path}
    features_version={@features_version}
  >
    <:page_icon :if={@kind != :index}>
      <.category_header_icon kind={@kind} />
    </:page_icon>
    <%= if @kind == :index do %>
      <!-- ============================================================== -->
      <!-- INDEX — 4 category cards: Retrieval, Data Sources, Notifications, AI Agents -->
      <!-- ============================================================== -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Retrieval -->
        <CardShell.card_shell
          id="category-card-retrieval"
          as={:article}
          class="group relative gap-4 overflow-hidden bg-white p-6 rounded-2xl border border-black/10 cursor-pointer"
          primary_link={%{destination: ~p"/bo/channels/retrieval"}}
        >
          <:header>
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200" />
            <div class="relative flex items-start justify-between">
              <div class="w-12 h-12 rounded-xl bg-blue-50 grid place-items-center">
                <svg
                  class="w-6 h-6 text-blue-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                >
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
              </div>
              <% retrieval_count =
                ZaqWeb.Live.BO.Communication.ChannelsIndexLive.retrieval_total(@stats) %>
              <.hub_config_count_badge count={retrieval_count} />
            </div>
          </:header>
          <div>
            <h3
              class="zaq-text-h4 mb-1"
              style="color: var(--zaq-text-color-body-default)"
            >
              Communication Channels
            </h3>
            <p
              class="zaq-text-body-sm leading-relaxed"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              Messaging platforms that receive user questions and return answers from ZAQ.
            </p>
          </div>
          <:footer>
            <div
              class="zaq-layout-inline-compact mt-auto"
              data-testid="channels-index-retrieval-icons"
            >
              <div
                :for={provider <- @retrieval_preview}
                class="w-6 h-6 rounded-md bg-black/[0.03] grid place-items-center"
                data-channel-preview={provider}
                title={provider}
              >
                <ZaqWeb.Components.ChannelIcons.icon provider={provider} class="w-3.5 h-3.5" />
              </div>
              <span
                class="zaq-text-caption ml-1"
                style="color: var(--zaq-text-color-body-tertiary)"
              >
                +more
              </span>
            </div>
          </:footer>
        </CardShell.card_shell>

        <!-- Data Sources -->
        <CardShell.card_shell
          id="category-card-data-source"
          as={:article}
          class="group relative gap-4 overflow-hidden bg-white p-6 rounded-2xl border border-black/10 cursor-pointer"
          primary_link={%{destination: ~p"/bo/channels/data_source"}}
        >
          <:header>
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200" />
            <div class="relative flex items-start justify-between">
              <div class="w-12 h-12 rounded-xl bg-amber-50 grid place-items-center">
                <svg
                  class="w-6 h-6 text-amber-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </div>
              <% data_source_count =
                ZaqWeb.Live.BO.Communication.ChannelsIndexLive.data_source_total(@stats) %>
              <.hub_config_count_badge count={data_source_count} />
            </div>
          </:header>
          <div>
            <h3
              class="zaq-text-h4 mb-1"
              style="color: var(--zaq-text-color-body-default)"
            >
              Data Sources
            </h3>
            <p
              class="zaq-text-body-sm leading-relaxed"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              Document sources that feed the knowledge base with files and content.
            </p>
          </div>
          <:footer>
            <div
              class="zaq-layout-inline-compact mt-auto"
              data-testid="channels-index-data-source-icons"
            >
              <div
                :for={provider <- @data_source_preview}
                class="w-6 h-6 rounded-md bg-black/[0.03] grid place-items-center"
                data-channel-preview={provider}
                title={provider}
              >
                <ZaqWeb.Components.ChannelIcons.icon provider={provider} class="w-3.5 h-3.5" />
              </div>
            </div>
          </:footer>
        </CardShell.card_shell>

        <!-- AI Agents — Coming Soon -->
        <CardShell.card_shell
          id="category-card-ai-agents"
          as={:article}
          variant={:muted}
          class="relative overflow-hidden zaq-card-shell-muted"
        >
          <:header>
            <div class="flex items-start justify-between">
              <div
                class="zaq-channel-card-icon-tile"
                style="background-color: var(--zaq-surface-color-accent); color: var(--zaq-text-color-body-accent)"
              >
                <ZaqWeb.Components.ChannelIcons.icon provider="ai_agents" class="zaq-icon-md" />
              </div>
              <.hub_coming_soon_badge />
            </div>
          </:header>
          <div>
            <h3
              class="zaq-text-h4 mb-1"
              style="color: var(--zaq-text-color-body-default)"
            >
              AI Agents
            </h3>
            <p
              class="zaq-text-body-sm leading-relaxed"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              Connect autonomous agents that read, respond, and act on messages across your stack.
            </p>
          </div>
        </CardShell.card_shell>
      </div>
    <% else %>
      <!-- ============================================================== -->
      <!-- SUB-PAGE — Provider grid for :retrieval or :data_source           -->
      <!-- ============================================================== -->
      <div class="mb-6">
        <ZaqWeb.Components.DesignSystem.Button.button
          variant={:ghost}
          icon="hero-arrow-left"
          navigate={~p"/bo/channels"}
          class="mb-4"
        >
          All Channels
        </ZaqWeb.Components.DesignSystem.Button.button>
        <div :if={@kind == :notification} class="flex justify-end">
          <.link
            navigate={~p"/bo/channels/notifications/logs"}
            class="inline-flex items-center gap-2 font-mono text-[0.75rem] font-bold px-4 py-2 rounded-xl bg-[#03b6d4] text-white hover:bg-[#029ab3] shadow-sm shadow-[#03b6d4]/20 transition-all"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
              />
            </svg>
            Delivery Logs
          </.link>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <CardShell.card_shell
          :for={card <- @cards}
          id={"channel-card-#{card.id}"}
          as={:article}
          class="group relative gap-4 overflow-hidden bg-white p-6 rounded-2xl border border-black/10 cursor-pointer"
          primary_link={
            %{
              destination:
                ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_path(@kind, card.id)
            }
          }
          footer_link={
            %{
              id: "channel-card-#{card.id}-configure",
              label: "Configure",
              destination:
                ZaqWeb.Live.BO.Communication.ChannelsIndexLive.provider_path(@kind, card.id),
              icon: "hero-arrow-right",
              icon_position: :right
            }
          }
        >
          <:header>
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
              style={"background: linear-gradient(to bottom right, #{card.color}08, transparent)"}
            />
            <div class="relative flex items-start justify-between">
              <div
                class="w-12 h-12 rounded-xl grid place-items-center"
                style={"background-color: #{card.color}14"}
              >
                <ZaqWeb.Components.ChannelIcons.icon provider={card.id} class="w-6 h-6" />
              </div>
              <% count = ZaqWeb.Live.BO.Communication.ChannelsIndexLive.stat_for(@stats, card.id) %>
              <.hub_config_count_badge count={count} />
            </div>
          </:header>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="zaq-text-h4" style="color: var(--zaq-text-color-body-default)">
                {card.label}
              </h3>
              <button
                :if={
                  @kind == :retrieval and
                    MapSet.member?(@configured_ingress_providers || MapSet.new(), card.id)
                }
                id={"ingress-status-dot-#{card.id}"}
                type="button"
                phx-click="open_ingress_status"
                phx-value-provider={card.id}
                class="inline-flex items-center justify-center"
                title="Ingress status"
              >
                <span class={[
                  "status",
                  if(Map.get(@ingress_status_loading || %{}, card.id),
                    do: "status-neutral animate-pulse",
                    else: IngressStatusUI.color(Map.get(@ingress_statuses || %{}, card.id))
                  )
                ]} />
              </button>
            </div>
            <p
              class="zaq-text-body-sm leading-relaxed"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              {card.desc}
            </p>
          </div>
        </CardShell.card_shell>
      </div>

      <ZaqWeb.Components.BOModal.form_dialog
        :if={@ingress_status_modal}
        id="ingress-status-modal"
        cancel_event="close_ingress_status"
        title="Ingress Status"
        max_width_class="zaq-modal--width-lg"
      >
        <div class="space-y-3 font-mono text-[0.75rem] text-black/70">
          <p class="font-bold text-black">{String.capitalize(@ingress_status_modal.provider)}</p>
          <p>
            {(@ingress_status_modal.status || %{})[:summary] || "No status details available"}
          </p>
          <p :if={reason = (@ingress_status_modal.status || %{})[:reason]}>
            Reason: {inspect(reason)}
          </p>
          <p :if={details = (@ingress_status_modal.status || %{})[:details]}>
            Details: {inspect(details)}
          </p>
          <div class="flex justify-end">
            <button
              type="button"
              phx-click="close_ingress_status"
              class="font-mono text-[0.75rem] px-4 py-2 rounded-lg border border-black/10 text-black/50 hover:text-black"
            >
              Close
            </button>
          </div>
        </div>
      </ZaqWeb.Components.BOModal.form_dialog>
    <% end %>
  </ZaqWeb.Components.BOLayout.bo_layout>
<% end %>
