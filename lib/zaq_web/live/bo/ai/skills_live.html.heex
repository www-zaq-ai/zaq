<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title="Skills"
  page_subtitle="Reusable instruction + tool bundles attachable to any agent"
  current_path={@current_path}
  features_version={@features_version}
>
  <div class="flex items-center justify-end mb-6">
    <DSButton.button
      id="new-skill-button"
      variant={:primary}
      icon="hero-plus"
      class="shrink-0"
      phx-click="new_skill"
    >
      Add Skill
    </DSButton.button>
  </div>
  
<!-- Filters -->
  <form id="skills-filter-form" phx-change="filter" class="grid grid-cols-2 gap-4 mb-6">
    <div>
      <label class="zaq-field-label-uppercase block mb-1.5">
        Search
      </label>
      <input
        type="text"
        name="filters[q]"
        value={@filters["q"]}
        placeholder="Name or description..."
        phx-debounce="300"
        class="w-full zaq-control-text"
      />
    </div>
    <div>
      <label class="zaq-field-label-uppercase block mb-1.5">
        Tags
      </label>
      <input
        type="text"
        name="filters[tag]"
        value={@filters["tag"]}
        placeholder="Comma-separated tags, matches any..."
        phx-debounce="300"
        class="w-full zaq-control-text"
      />
    </div>
  </form>

  <div id="skills-master-pane">
    <DSTable.table id="skills-table" scrollable>
      <:caption>Skills ({length(@skills)})</:caption>
      <:head>
        <DSTable.table_head_row>
          <DSTable.table_cell element={:th}>Name</DSTable.table_cell>
          <DSTable.table_cell element={:th}>Tags</DSTable.table_cell>
          <DSTable.table_cell element={:th}>Tools</DSTable.table_cell>
          <DSTable.table_cell element={:th}>Status</DSTable.table_cell>
        </DSTable.table_head_row>
      </:head>
      <:body>
        <DSTable.table_empty :if={@skills == []} colspan={4}>
          No skills found.
        </DSTable.table_empty>
        <DSTable.table_row
          :for={skill <- @skills}
          id={"skill-row-#{skill.id}"}
          variant={
            if(@selected_skill != nil and @selected_skill.id == skill.id,
              do: :selected,
              else: :default
            )
          }
          click="select_skill"
          click_values={%{id: skill.id}}
        >
          <DSTable.table_cell>
            <p
              class="zaq-text-body-sm truncate"
              style="color: var(--zaq-text-color-body-default)"
            >
              {skill.name}
            </p>
            <p
              :if={skill.description}
              class="zaq-text-caption truncate"
              style="color: var(--zaq-text-color-body-tertiary)"
            >
              {skill.description}
            </p>
          </DSTable.table_cell>
          <DSTable.table_cell>
            <span
              :for={tag <- skill.tags}
              class="zaq-pill zaq-text-caption zaq-pill--elevated mr-1"
            >
              {tag}
            </span>
          </DSTable.table_cell>
          <DSTable.table_cell>
            <span class="zaq-text-body-sm" style="color: var(--zaq-text-color-body-secondary)">
              {length(skill.tool_keys)}
            </span>
          </DSTable.table_cell>
          <DSTable.table_cell>
            <span class={[
              "zaq-pill zaq-text-caption",
              if(skill.active, do: "zaq-pill--success", else: "zaq-pill--elevated")
            ]}>
              {if skill.active, do: "active", else: "inactive"}
            </span>
          </DSTable.table_cell>
        </DSTable.table_row>
      </:body>
    </DSTable.table>
  </div>

  <% unselected_tool_options =
    @tools
    |> Enum.reject(&(&1.key in @form_tool_keys))
    |> Enum.map(&{"#{&1.label} (#{&1.key})", &1.key}) %>
  <% unselected_mcp_options =
    @mcp_endpoints
    |> Enum.reject(&(&1.id in @form_mcp_endpoint_ids))
    |> Enum.map(&{"#{&1.name} (##{&1.id})", &1.id}) %>
  <% drawer_return_focus_id =
    if @mode == :new do
      "new-skill-button"
    else
      if @selected_skill != nil,
        do: "skill-row-#{@selected_skill.id}",
        else: "new-skill-button"
    end %>

  <Drawer.form_drawer
    id="skill-form-drawer"
    is_open={@mode in [:new, :edit]}
    on_close="cancel_skill_form"
    title={if @mode == :new, do: "Create Skill", else: "Edit Skill"}
    placement={:right}
    size={:two_thirds}
    return_focus_id={drawer_return_focus_id}
    data-testid="skills-detail-pane"
  >
    <.form
      for={@form}
      id="skill-form"
      phx-change="validate"
      phx-submit="save"
      phx-hook="ScrollToFirstError"
      class="space-y-5"
    >
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="zaq-field-label-uppercase block mb-1.5">
            Name
          </label>
          <input
            type="text"
            name="skill[name]"
            value={@form[:name].value}
            placeholder="lowercase-kebab-case"
            class="w-full zaq-control-text"
          />
          <p
            :for={error <- field_errors(@form[:name])}
            class="zaq-field-error mt-1"
          >
            {error}
          </p>
        </div>
        <div>
          <label class="zaq-field-label-uppercase block mb-1.5">
            Tags
          </label>
          <input
            type="text"
            name="skill[tags]"
            value={tags_to_string(@form[:tags].value)}
            placeholder="math, utility"
            class="w-full zaq-control-text"
          />
        </div>
      </div>

      <div>
        <label class="zaq-field-label-uppercase block mb-1.5">
          Description
        </label>
        <input
          type="text"
          name="skill[description]"
          value={@form[:description].value}
          class="w-full zaq-control-text"
        />
        <p
          :for={error <- field_errors(@form[:description])}
          class="zaq-field-error mt-1"
        >
          {error}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <div class="mb-2 flex items-center justify-between">
            <label class="zaq-field-label-uppercase block">
              Tools
            </label>
            <DSButton.button
              id="add-tools-button"
              variant={:secondary}
              type="button"
              class="shrink-0"
              phx-click="open_tools_picker"
              disabled={@tools == [] or unselected_tool_options == []}
            >
              + Add tools
            </DSButton.button>
          </div>
          <div
            :if={@tools == []}
            class="rounded-lg border border-dashed px-3 py-2 zaq-text-caption"
            style="border-color: var(--zaq-border-color-default); color: var(--zaq-text-color-body-tertiary)"
          >
            No tools are currently registered in code.
          </div>
          <.selected_tools_panel
            :if={@tools != []}
            tools={@tools}
            selected_keys={@form_tool_keys}
          />
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <label class="zaq-field-label-uppercase block">
              MCP Endpoints
            </label>
            <DSButton.button
              id="add-mcp-button"
              variant={:secondary}
              type="button"
              class="shrink-0"
              phx-click="open_mcp_picker"
              disabled={unselected_mcp_options == []}
            >
              + Add MCP
            </DSButton.button>
          </div>
          <div
            :if={@mcp_endpoints == []}
            class="rounded-lg border border-dashed px-3 py-2 zaq-text-caption"
            style="border-color: var(--zaq-border-color-default); color: var(--zaq-text-color-body-tertiary)"
          >
            No MCP endpoints are configured. Add one in System Config.
          </div>
          <.selected_mcp_panel
            :if={@mcp_endpoints != []}
            mcp_endpoints={@mcp_endpoints}
            selected_endpoint_ids={@form_mcp_endpoint_ids}
          />
        </div>
      </div>

      <div>
        <label class="zaq-field-label-uppercase block mb-1.5">
          Allowed tools
        </label>
        <input
          type="text"
          name="skill[allowed_tools]"
          value={allowed_tools_to_string(@form[:allowed_tools].value)}
          placeholder="Read Bash create_document"
          class="w-full zaq-control-text"
        />
        <p
          class="zaq-text-caption mt-1"
          style="color: var(--zaq-text-color-body-tertiary)"
        >
          Open Agent Skills tool names this skill may use (space-separated). Stored and shown to the
          model, but not enforced yet. Distinct from the ZAQ <strong>Tools</strong>
          above, which are
          the tools ZAQ provisions on the agent.
        </p>
        <p
          :for={error <- field_errors(@form[:allowed_tools])}
          class="zaq-field-error mt-1"
        >
          {error}
        </p>
      </div>

      <%!-- Resources: reference files stored on an ingestion volume under
            .agents/skills/{slug}/references/ --%>
      <div>
        <div class="mb-2 flex items-center justify-between">
          <label class="zaq-field-label-uppercase block">
            Resources
          </label>
          <%!-- Hidden until a name exists, because the destination path is derived from
                it. A disabled button would read as "temporarily off" rather than "not
                applicable yet". Secondary variant — the drawer footer already owns this
                drawer's single primary button. --%>
          <DSButton.button
            :if={resources_addable?(assigns)}
            id="add-resource-button"
            variant={:secondary}
            type="button"
            class="shrink-0"
            phx-click="open_resource_upload"
          >
            Add resource
          </DSButton.button>
        </div>

        <DSTable.table id="skill-resources-table">
          <:head>
            <DSTable.table_head_row>
              <DSTable.table_cell element={:th}>File</DSTable.table_cell>
              <DSTable.table_cell element={:th}>Size</DSTable.table_cell>
              <DSTable.table_cell element={:th}>Modified</DSTable.table_cell>
              <DSTable.table_cell element={:th}>
                <span class="sr-only">Actions</span>
              </DSTable.table_cell>
            </DSTable.table_head_row>
          </:head>
          <:body>
            <DSTable.table_empty
              :if={@skill_resources == [] and @uploads.skill_resources.entries == []}
              colspan={4}
            >
              No resources yet.
            </DSTable.table_empty>
            <%!-- Staged: uploaded to the server but not yet written to a volume, because
                  the skill has no destination until it is saved. --%>
            <DSTable.table_row :for={entry <- @uploads.skill_resources.entries}>
              <DSTable.table_cell>
                <DSTable.table_text label={entry.client_name} />
              </DSTable.table_cell>
              <DSTable.table_cell>
                <DSTable.table_text
                  label={ZaqWeb.Helpers.SizeFormat.format_size(entry.client_size)}
                  tone={:secondary}
                />
              </DSTable.table_cell>
              <DSTable.table_cell>
                <span class="zaq-pill zaq-text-caption zaq-pill--elevated">Pending</span>
              </DSTable.table_cell>
              <DSTable.table_cell></DSTable.table_cell>
            </DSTable.table_row>
            <DSTable.table_row :for={resource <- @skill_resources}>
              <DSTable.table_cell>
                <DSTable.table_text label={resource.name} />
              </DSTable.table_cell>
              <DSTable.table_cell>
                <DSTable.table_text
                  label={ZaqWeb.Helpers.SizeFormat.format_size(resource.size)}
                  tone={:secondary}
                />
              </DSTable.table_cell>
              <DSTable.table_cell>
                <DSTable.table_datetime value={resource.modified_at} />
              </DSTable.table_cell>
              <DSTable.table_cell>
                <DSButton.button
                  variant={:ghost}
                  icon_only
                  type="button"
                  aria-label={"Remove #{resource.name}"}
                  phx-click="remove_skill_resource"
                  phx-value-file_id={resource.id}
                  data-role="remove-skill-resource"
                >
                  <.icon name="hero-trash" class="zaq-icon-sm" />
                </DSButton.button>
              </DSTable.table_cell>
            </DSTable.table_row>
          </:body>
        </DSTable.table>
        <p
          class="zaq-text-caption mt-1"
          style="color: var(--zaq-text-color-body-tertiary)"
        >
          {if @mode == :new,
            do: "Name the skill to add resources — they upload when you save.",
            else: "Reference files, stored on an ingestion volume."}
        </p>
      </div>

      <div>
        <label class="zaq-field-label-uppercase block mb-1.5">
          Instructions
        </label>
        <.markdown_editor
          id="skill-body-input"
          field={@form[:body]}
          preview={@body_preview}
          toggle_event="toggle_body_preview"
          rows={10}
          placeholder="Markdown instructions injected into the agent's system prompt..."
        />
        <p
          :for={error <- field_errors(@form[:body])}
          class="zaq-field-error mt-1"
        >
          {error}
        </p>
      </div>

      <label
        class="flex items-center gap-2 zaq-text-body-sm"
        style="color: var(--zaq-text-color-body-secondary)"
      >
        <input type="hidden" name="skill[active]" value="false" />
        <input
          type="checkbox"
          name="skill[active]"
          value="true"
          checked={@form[:active].value in [true, "true"]}
          class="zaq-bo-checkbox"
        /> Active
      </label>
    </.form>

    <:actions>
      <div class={[
        "flex w-full items-center",
        if(@mode == :edit and @selected_skill != nil, do: "justify-between", else: "justify-end")
      ]}>
        <DSButton.button
          :if={@mode == :edit and @selected_skill != nil}
          id="delete-skill-button"
          variant={:tertiary}
          danger
          type="button"
          phx-click="delete_skill"
          phx-value-id={@selected_skill.id}
          data-confirm="Delete this skill? Agents using it will lose its tools and instructions, and its uploaded resources will be removed from the volume."
        >
          Delete Skill
        </DSButton.button>
        <div class="zaq-layout-inline">
          <DSButton.button
            id="close-skill-detail"
            variant={:secondary}
            type="button"
            phx-click="cancel_skill_form"
          >
            Cancel
          </DSButton.button>
          <DSButton.button
            id="save-skill-button"
            variant={:primary}
            type="submit"
            form="skill-form"
          >
            {if @mode == :new, do: "Create Skill", else: "Save Skill"}
          </DSButton.button>
        </div>
      </div>
    </:actions>
  </Drawer.form_drawer>

  <%!-- The ingestion upload modal, configured for skill references: volume picker and
        destination preview on, folder-drop off (references are a flat directory). --%>
  <ModalUpload.modal_upload
    :if={@resource_modal == :upload}
    id="skill-resource-modal"
    title="Add resource"
    cancel_event="close_resource_modal"
    uploads={@uploads}
    volumes={@volumes}
    current_volume={@resource_volume}
    volume_event="select_resource_volume"
    destination={resource_destination(assigns)}
    upload_name={:skill_resources}
    id_prefix="skill-resource"
    submit_event="upload_skill_resource"
    change_event="validate_skill_resource"
    file_cancel_event="cancel_skill_resource"
    label="Reference file"
    submit_label="Add"
    hint={resource_upload_hint()}
    folder_drop?={false}
  />

  <ModalUpload.modal_no_volume :if={@resource_modal == :no_volume} />

  <%!-- Upload results report here, not in the BOLayout flash: the drawer is open when a
        resource is added, and an inline banner renders behind it. Same affordance the
        ingestion jobs drawer uses (`#ingest-toast`). --%>
  <.flash
    :if={@upload_toast}
    id="resource-upload-toast"
    kind={@upload_toast.kind}
    flash={%{}}
    auto_dismiss
    auto_dismiss_duration={5000}
    on_clear="dismiss_upload_toast"
  >
    {@upload_toast.message}
  </.flash>

  <ZaqWeb.Components.BOModal.modal_shell
    :if={@tools_picker_open}
    id="skill-tools-picker-modal"
    cancel_event="close_tools_picker"
    title="Add tools"
    max_width_class="zaq-modal--width-lg"
  >
    <form phx-change="add_tool_from_picker">
      <.searchable_select
        id="skill-tools-picker-select"
        name="tool_key"
        value={@tools_picker_value}
        options={unselected_tool_options}
        placeholder="Search by tool name..."
        empty_label="Choose a tool to add..."
        compact={true}
      />
    </form>

    <div class="mt-4">
      <p
        class="mb-2 uppercase tracking-wider zaq-text-caption"
        style="color: var(--zaq-text-color-body-tertiary)"
      >
        Enabled tools
      </p>
      <.selected_tools_panel tools={@tools} selected_keys={@form_tool_keys} />
    </div>

    <p class="mt-3 zaq-text-caption" style="color: var(--zaq-text-color-body-tertiary)">
      Pick one tool at a time. This modal stays open to add multiple tools quickly.
    </p>
  </ZaqWeb.Components.BOModal.modal_shell>

  <ZaqWeb.Components.BOModal.modal_shell
    :if={@mcp_picker_open}
    id="skill-mcp-picker-modal"
    cancel_event="close_mcp_picker"
    title="Add MCP endpoints"
    max_width_class="zaq-modal--width-lg"
  >
    <form phx-change="add_mcp_from_picker">
      <.searchable_select
        id="skill-mcp-picker-select"
        name="endpoint_id"
        value={@mcp_picker_value}
        options={unselected_mcp_options}
        placeholder="Search by endpoint name..."
        empty_label="Choose an MCP endpoint to add..."
        compact={true}
      />
    </form>

    <div class="mt-4">
      <p
        class="mb-2 uppercase tracking-wider zaq-text-caption"
        style="color: var(--zaq-text-color-body-tertiary)"
      >
        Attached MCP endpoints
      </p>
      <.selected_mcp_panel
        mcp_endpoints={@mcp_endpoints}
        selected_endpoint_ids={@form_mcp_endpoint_ids}
      />
    </div>

    <p class="mt-3 zaq-text-caption" style="color: var(--zaq-text-color-body-tertiary)">
      Pick one endpoint at a time. This modal stays open to add multiple endpoints quickly.
    </p>
  </ZaqWeb.Components.BOModal.modal_shell>
</ZaqWeb.Components.BOLayout.bo_layout>
