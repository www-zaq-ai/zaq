<%!-- lib/zaq_web/live/bo/ai/ingestion_live.html.heex --%>
<ZaqWeb.Components.BOLayout.bo_layout
  current_user={@current_user}
  flash={@flash}
  page_title="Ingestion"
  current_path={@current_path}
  features_version={@features_version}
  auto_dismiss={false}
>
  <.ingestion_embedding_banner :if={not @embedding_ready} />

  <div :if={not @data_source_enabled?} class="space-y-6 min-w-0">
    <.no_data_source_enabled_empty_state />
  </div>

  <div :if={@data_source_enabled?} class="space-y-6 min-w-0">
    <.source_selector
      :if={@active_source_id && length(@source_scopes) > 1}
      active_source_id={@active_source_id}
      sources={@source_scopes}
    />

    <div>
      <div class="zaq-ingestion-chrome-row zaq-ingestion-chrome-row--spaced">
        <.toggle
          value={@view_mode}
          event="toggle_view_mode"
          value_param="mode"
          suffix={"#{length(@entries)} item(s)"}
          choices={[
            %{value: "list", icon: "hero-bars-3", title: "List view"},
            %{value: "grid", icon: "hero-squares-2x2", title: "Grid view"}
          ]}
        />
        <.file_browser_header
          selected={@selected}
          ingest_mode={@ingest_mode}
          embedding_ready={@embedding_ready}
          selected_watchable_count={
            selected_watchable_count(@selected, @records_by_path, @ingestion_map)
          }
          selected_watched_count={
            selected_watched_count(@selected, @records_by_path, @ingestion_map)
          }
          watch_supported={@watch_supported}
          watch_disabled_reason={@watch_disabled_reason}
          action_capabilities={@action_capabilities}
          create_item_supported={@create_item_supported}
          active_jobs_count={active_jobs_count(@jobs)}
        />
      </div>
      <p
        :if={@provider_error}
        class="zaq-text-body-sm mb-3"
        style="color: var(--zaq-text-color-body-danger)"
      >
        {@provider_error}
      </p>
      <.breadcrumb breadcrumbs={@breadcrumbs} current_dir={@current_dir} />
      <.file_list_view
        :if={@view_mode == "list"}
        entries={@entries}
        selected={@selected}
        current_dir={@current_dir}
        ingestion_map={@ingestion_map}
        action_capabilities={@action_capabilities}
        watch_supported={@watch_supported}
        watch_disabled_reason={@watch_disabled_reason}
      />
      <.file_grid_view
        :if={@view_mode == "grid"}
        entries={@entries}
        selected={@selected}
        current_dir={@current_dir}
        ingestion_map={@ingestion_map}
        action_capabilities={@action_capabilities}
        watch_supported={@watch_supported}
        watch_disabled_reason={@watch_disabled_reason}
      />
    </div>
  </div>

  <.flash
    :if={@ingest_toast}
    id="ingest-toast"
    kind={@ingest_toast.kind}
    flash={%{}}
    auto_dismiss
    auto_dismiss_duration={5000}
    on_clear="dismiss_ingest_toast"
  >
    {@ingest_toast.message}
  </.flash>

  <Drawer.drawer
    id="ingestion-jobs-drawer"
    is_open={@jobs_drawer_open}
    on_close="close_jobs_drawer"
    placement={:right}
    size={:one_third}
    return_focus_id="monitor-jobs-button"
    panel_class="zaq-drawer--responsive-one-third"
    padding={:flush}
  >
    <:header>
      <h3
        id="ingestion-jobs-drawer-title"
        class="zaq-text-h3"
        style="color: var(--zaq-text-color-body-default)"
      >
        Jobs
      </h3>
    </:header>
    <div class="p-4">
      <.jobs_panel jobs={@jobs} status_filter={@status_filter} prep_progress={@prep_progress} />
    </div>
  </Drawer.drawer>

  <%!-- ——— Modals ——— --%>
  <.modal_add_raw
    :if={@modal == :add_raw}
    modal_error={@modal_error}
    modal_name={@modal_name}
    current_dir={@current_dir}
  />
  <.modal_rename :if={@modal == :rename} modal_error={@modal_error} modal_name={@modal_name} />
  <.modal_delete :if={@modal == :delete} modal_error={@modal_error} modal_name={@modal_name} />
  <.modal_delete_selected :if={@modal == :delete_selected} selected={@selected} />
  <.modal_new_folder
    :if={@modal == :new_folder}
    modal_error={@modal_error}
    modal_name={@modal_name}
  />
  <.modal_upload
    :if={@modal == :upload}
    uploads={@uploads}
    embedding_ready={@embedding_ready}
    folder_drop_skipped={@folder_drop_skipped}
  />
  <.modal_move
    :if={@modal == :move}
    modal_error={@modal_error}
    modal_name={@modal_name}
    move_current_dir={@move_current_dir}
    move_breadcrumbs={@move_breadcrumbs}
    move_folders={@move_folders}
  />
  <.modal_share
    :if={@modal == :share}
    modal_name={@modal_name}
    modal_error={@modal_error}
    share_modal_is_folder={@share_modal_is_folder}
    share_modal_is_public={@share_modal_is_public}
    share_modal_original_is_public={@share_modal_original_is_public}
    share_modal_public_inherited?={@share_modal_public_inherited?}
    share_modal_removed?={@share_modal_removed?}
    share_modal_permissions={@share_modal_permissions}
    share_modal_targets_options={@share_modal_targets_options}
    share_modal_pending={@share_modal_pending}
    share_modal_read_only={@share_modal_read_only}
    share_modal_notice={@share_modal_notice}
  />
  <.modal_watch_error
    :if={@modal == :watch_error}
    modal_name={@modal_name}
    watch_error_message={@watch_error_message}
  />
  <ZaqWeb.Components.FilePreviewModal.modal
    :if={@modal == :preview and @preview}
    preview={@preview}
    cancel_event="close_preview_modal"
  />
</ZaqWeb.Components.BOLayout.bo_layout>
